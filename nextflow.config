manifest {
    name = 'MINT'
    description = 'Motor Interhemispheric Neurophysiology Toolbox'
    version = '0.1.0-dev'
    mainScript = 'MINT.nf'
    nextflowVersion = '>=25.04.0'
}

params {
    input = "${projectDir}/input"
    outdir = "${projectDir}/results"
    MEP = true
    CSP = true
    IHI = true
    slim = false
    multiqc = true
    strict_timepoints = true
    help = false
    octave = 'octave-cli'
    multiqc_bin = 'multiqc'
    container = 'docker.io/marvinp45/tms-pipeline@sha256:1eb4e5f42371b0ae308784e141d8ead1d9a1221d9717627205cb23897c8537db'
    queue = null
    account = null
}

includeConfig 'conf/base.config'

profiles {
    standard { includeConfig 'conf/docker.config' }
    docker { includeConfig 'conf/docker.config' }
    apptainer { includeConfig 'conf/apptainer.config' }
    local { includeConfig 'conf/local.config' }
    slurm { includeConfig 'conf/slurm.config' }
}
