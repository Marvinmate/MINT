process {
    cpus = 1
    memory = '2 GB'
    time = '30m'
    cache = 'deep'
    maxForks = 4
    withLabel: 'plot' {
        memory = '4 GB'
        time = '1h'
    }
}
env.OMP_NUM_THREADS = '1'
env.OPENBLAS_NUM_THREADS = '1'

trace {
    enabled = params.help.toString().toLowerCase() != 'true'
    file = "${params.outdir}/execution/trace.tsv"
    overwrite = true
}
