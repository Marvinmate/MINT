apptainer.enabled = true
apptainer.autoMounts = true
apptainer.cacheDir = env('NXF_APPTAINER_CACHEDIR') ?: "${projectDir}/.apptainer-cache"
process.container = params.container

// Install the date shim before Nextflow starts its in-container trace wrapper.
apptainer.runOptions = "--bind '${projectDir.toString().replace("'", "'\"'\"'")}/compat:/opt/mint-compat:ro' --env PREPEND_PATH=/opt/mint-compat"
